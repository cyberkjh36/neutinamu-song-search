    <AssemblyName>Neutinamu_Room_Remote_1.3.0</AssemblyName><Version>1.3.0</Version><ApplicationIcon>Remote.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Drawing"/><Reference Include="System.Net.Http"/>
    <Reference Include="System.Web.Extensions"/><Reference Include="Microsoft.CSharp"/>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all"/>
    <EmbeddedResource Include="$(RoomProfiles)" LogicalName="rooms.json"/>
  </ItemGroup>
</Project>
